{
  "name": "cookiefox",
  "version": "2.0.12",
  "description": "",
  "main": "assets/js/main.js",
  "dependencies": {
    "focus-trap": "^6.7.3",
    "js-cookie": "^3.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@wp-playground/cli": "^3.1.50",
    "autoprefixer": "^10.4.4",
    "bestzip": "^2.2.0",
    "copyfiles": "^2.4.1",
    "postcss": "^8.4.12",
    "postcss-csso": "^6.0.0",
    "rollup": "^4.46.2",
    "rollup-plugin-css-only": "^4.5.2",
    "rollup-plugin-svelte": "^7.2.2",
    "sass": "^1.49.10",
    "svelte": "^4.2.19",
    "svelte-preprocess": "^6.0.3"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -w -c",
    "release:zip": "bestzip release/zip/cookiefox.zip assets/* cookiefox.php includes/* vendor/* languages/* readme.txt wpml-config.xml uninstall.php",
    "release": "copyfiles './assets/**/*' ./cookiefox.php './includes/**/*' './vendor/**/*' 'languages/**/*' ./readme.txt ./wpml-config.xml ./uninstall.php release/files/cookiefox",
    "release:test": "copyfiles './assets/**/*' ./cookiefox.php './includes/**/*' './vendor/**/*' 'languages/**/*' ./readme.txt ./wpml-config.xml ./uninstall.php /Users/fabianpimminger/Development/web/cmp-test/wp-content/plugins/cookiefox",
    "release:wporg": "bash scripts/release-wporg.sh",
    "release:wporg:dry": "bash scripts/release-wporg.sh --dry-run",
    "playground": "npx @wp-playground/cli server --auto-mount --blueprint=tests/e2e/blueprint.json --blueprint-may-read-adjacent-files --port=9400",
    "test:e2e": "npx playwright test",
    "test:e2e:install": "npx playwright install chromium"
  },
  "author": "",
  "license": "GPL-2.0-or-later"
}
